{
	"scripts": {
		"dev": "tsx src/bot.ts",
		"start": "node dist/bot.js",
		"build": "tsup",
		"deploy-commands": "tsx src/slash-command-deployment.ts",
		"deploy-commands:prod": "node dist/slash-command-deployment.js",
		"db:generate": "prisma generate --schema=./src/storage/schema.prisma",
		"db:push": "prisma db push --schema=./src/storage/schema.prisma",
		"lint": "eslint src/**/*.{ts,tsx,md} --no-error-on-unmatched-pattern && prettier --check src/**/*.{ts,tsx,md} --no-error-on-unmatched-pattern && npm run lang:check",
		"lang:check": "tsx scripts/check-lang-parity.ts",
		"lint:fix": "eslint src/**/*.{ts,tsx,md} --fix --no-error-on-unmatched-pattern",
		"lint:staged": "eslint src/**/*.{ts,tsx,md} --fix --no-error-on-unmatched-pattern",
		"prettier": "prettier --write src/**/*.{ts,tsx,md} --no-error-on-unmatched-pattern",
		"prettier:staged": "prettier --write",
		"format": "npm run prettier",
		"format:staged": "npm run prettier:staged && npm run lint:staged",
		"type-check": "tsc --noEmit",
		"prepare": "husky",
		"postinstall": "patch-package"
	},
	"lint-staged": {
		"*.{ts,tsx}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{json,md}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.4.2",
		"@prisma/client": "^7.4.2",
		"@prisma/extension-accelerate": "^1.2.2",
		"@snazzah/davey": "^0.1.10",
		"bgutils-js": "^4.0.3",
		"discord-player": "^7.2.0",
		"discord-player-deezer": "^2.5.0",
		"discord-player-spotify": "^1.1.7",
		"discord-player-youtubei": "^3.1.0",
		"discord.js": "^14.17.2",
		"dotenv": "^16.6.1",
		"googlevideo": "^4.1.1",
		"mediaplex": "^1.0.0",
		"meriyah": "^6.1.4",
		"patch-package": "8.0.1",
		"pg": "^8.20.0",
		"simple-ytdl-core": "^1.1.1",
		"undici": "^7.30.1",
		"winston": "^3.13.0"
	},
	"devDependencies": {
		"@types/pg": "^8.18.0",
		"@typescript-eslint/eslint-plugin": "^8.11.0",
		"@typescript-eslint/parser": "^8.11.0",
		"eslint": "9.26.0",
		"eslint-config-prettier": "^9.1.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.1.6",
		"prettier": "^3.3.3",
		"prisma": "^7.4.2",
		"tsup": "^8.5.0",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3"
	},
	"type": "module"
}
